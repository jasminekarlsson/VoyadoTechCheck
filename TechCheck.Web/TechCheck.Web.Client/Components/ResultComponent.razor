<div class="container">
    <h3 class="p-3 text-center">Search results for "@(SearchWord)"</h3>
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Search Engine Name</th>
                <th>Number of results</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var result in Result)
            {
                <tr>
                    <td>@result.SiteName</td>
                    <td>@String.Format("{0:#,##0}", result.NumberOfResults)</td>
                </tr>
            }
        </tbody>
    </table>
</div>