<EditForm Model=@SearchParameter OnValidSubmit=@Search>
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="form-group">
        <div class="mt-3">
            <h2>Search...</h2>
        </div>
        <div class="my-2">
            <InputText DisplayName="Search" @bind-Value="@SearchParameter"></InputText>
            <ValidationMessage For="() => SearchParameter" />
        </div>

    </div>

    <div class="my-2">
        <input type="submit" class="btn btn-primary" value="Search" />
    </div>
</EditForm>